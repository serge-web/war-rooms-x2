{
  "name": "@wrx/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared presentational components over Radix, styled only by the --wrx-* custom properties (D24, NFR-14, NFR-18). Storybook lives here.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir dist/storybook --quiet"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-toast": "1.2.24",
    "@wrx/schemas": "workspace:*",
    "@wrx/theme": "workspace:*",
    "dompurify": "3.4.16",
    "marked": "18.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "20.14.6",
    "jsdom": "29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.1",
    "vite": "^8.3.5"
  }
}
