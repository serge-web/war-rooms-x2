# WRX1 reference deployment settings. ops/offline-install.sh --env <this file> copies it to
# WRX_HOME/wrx1.env on the first install; later installs keep the installed copy. KEY=value
# lines only: no quotes, no spaces around '=', no secrets (the admin password is asked for at
# install and never written down).

# The XMPP domain, which is also the host name users type in the browser
# (https://WRX_DOMAIN/): ejabberd serves its web pages only under its own domain. Role and admin
# accounts are <id>@WRX_DOMAIN. Lower case, dots allowed; the server certificate must name it
# (subjectAltName), and the network's DNS must resolve it to this host.
WRX_DOMAIN=wrx.exercise.internal

# Where the HTTPS and wss:// port is published on the host. 443 needs no port in the URL.
WRX_HTTPS_PORT=443
WRX_BIND_ADDRESS=0.0.0.0

# Shown in the client's backend badge (PLY-1).
WRX_LABEL=Exercise server
