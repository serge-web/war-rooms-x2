{
  "name": "war-rooms-x2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tools/tsconfig.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter @wrx/web e2e",
    "dictionary": "pnpm --filter @wrx/schemas dictionary",
    "check:dictionary": "pnpm --filter @wrx/schemas dictionary --check",
    "check:mermaid": "node tools/check-mermaid.ts",
    "check:trace": "node tools/check-traceability.ts",
    "check:bundle": "node tools/check-bundle.ts apps/web/dist",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:trace && pnpm check:dictionary"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "mermaid": "^12.2.0",
    "playwright": "1.63.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
