{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wrx1:json-schema:template-message.schema.json",
  "title": "Template message body",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "template"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "content": {
      "$ref": "#/$defs/TemplateContent"
    }
  },
  "required": [
    "type",
    "schemaVersion",
    "content"
  ],
  "description": "A templated message",
  "$defs": {
    "TemplateContent": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "The template used"
        },
        "values": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "A template field name",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Field values by field name; pickers hold GUIDs, never names (TPL-8)",
          "maxProperties": 100
        }
      },
      "required": [
        "templateId",
        "values"
      ]
    }
  }
}
